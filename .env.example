# Copy this file to `.env` and fill in your keys, then `source .env`.

# Semantic Scholar API key (REQUIRED for reliable throughput).
# Request one for free at: https://www.semanticscholar.org/product/api#api-key-form
# The key is emailed to you, usually within a couple of days.
export S2_API_KEY=""

# Contact e-mail for the OpenAlex "polite pool" (OPTIONAL, no signup).
# Not a key — OpenAlex simply gives faster, more reliable service to requests
# that identify themselves. Used by scripts/crosscheck_sources.py.
export OPENALEX_MAILTO=""

# IEEE Xplore Metadata API key (OPTIONAL).
# Enables `--sources ieee` in scripts/crosscheck_sources.py, as a fourth
# independent check on conference coverage, and gives better links.
# Requires an institutional subscription: https://developer.ieee.org/
export IEEE_XPLORE_API_KEY=""

# dblp, OpenAlex and Crossref — the default cross-check sources — need no keys.
